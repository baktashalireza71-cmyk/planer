.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# platform / sandbox files (not part of the app)
.env
Caddyfile
.zscripts/
/examples/
/tests/
/download/
/tool-results/
/worklog.md
.claude
.z-ai-config

# local database & user uploads (runtime data, not code)
/db/*.db
/db/*.db-journal
/db/uploads/

# temporary downloadable source zip (served via /planner-man-source.zip)
/public/planner-man-source.zip

# android / capacitor — build outputs & local files (source is committed, builds are not)
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
android/local.properties
android/.idea/
android/captures/
# signing secrets — never commit
android/key.properties
android/app/upload-keystore.jks
android/*.jks
android/*.keystore
# copied web assets — regenerated by `cap sync`
android/app/src/main/assets/public/
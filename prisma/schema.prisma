generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:/home/z/my-project/db/custom.db"
}

// ─────────────────────────────────────────────
//  کارها (Tasks)
// ─────────────────────────────────────────────
model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  category    String    @default("PERSONAL") // WORK | PERSONAL | STUDY | HEALTH | OTHER
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  subtasks    Subtask[]
}

model Subtask {
  id     String  @id @default(cuid())
  title  String
  done   Boolean @default(false)
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
//  عادت‌ها (Habits)
// ─────────────────────────────────────────────
model Habit {
  id            String     @id @default(cuid())
  title         String
  icon          String     @default("Sparkles")
  color         String     @default("#F97316")
  targetPerWeek Int        @default(7)
  createdAt     DateTime   @default(now())
  logs          HabitLog[]
}

model HabitLog {
  id      String @id @default(cuid())
  habitId String
  habit   Habit  @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    String // "YYYY-MM-DD"
  @@unique([habitId, date])
}

// ─────────────────────────────────────────────
//  اهداف (Goals)
// ─────────────────────────────────────────────
model Goal {
  id          String    @id @default(cuid())
  title       String
  description String?
  target      Int       @default(100)
  current     Int       @default(0)
  unit        String    @default("%")
  color       String    @default("#10B981")
  deadline    DateTime?
  createdAt   DateTime  @default(now())
}

// ─────────────────────────────────────────────
//  یادداشت‌ها (Notes)
// ─────────────────────────────────────────────
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @default("")
  color     String   @default("#FEF3C7")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  تنظیمات مرکزی برنامه (AppSettings) - تک‌ردیفی (id=1)
//  شامل تبلیغ، کانال ارتباطی و متن خوشامد — فقط فیلدهای عمومی، بدون راز
// ─────────────────────────────────────────────
model AppSettings {
  id             Int      @id @default(1)
  // نمایش/عدم‌نمایش بنر تبلیغ
  adsEnabled     Boolean  @default(false)
  adTitle        String   @default("")
  adText         String   @default("")
  adImage        String?  // آدرس تصویر تبلیغ (http/https)
  adButtonText   String   @default("")
  adLink         String   @default("") // لینک دکمه تبلیغ (http/https)
  // کانال ارتباطی: WHATSAPP | TELEGRAM | BALE | NONE
  contactChannel String   @default("NONE")
  contactTarget  String   @default("") // شماره واتساپ یا آیدی تلگرام/بله
  contactMessage String   @default("") // پیام پیش‌فرض هنگام باز شدن چت
  welcomeText    String   @default("") // متن کارت خوشامد داشبورد
  // با هر افزایش، کارت خوشامد برای همه کاربران دوباره نمایش داده می‌شود
  welcomeVersion Int      @default(1)
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────
//  اعتبار مدیر (AdminCredential) - تک‌ردیفی (id=1)
//  رمز هش‌شده scrypt + وضعیت قفل ضدحمله (هرگز از API عمومی برنمی‌گردد)
// ─────────────────────────────────────────────
model AdminCredential {
  id             Int       @id @default(1)
  passwordHash   String    // قالب "scrypt:<salt>:<hash>"
  failedAttempts Int       @default(0) // تعداد تلاش‌های ناموفق فعلی
  lockedUntil    DateTime? // اگر در آینده باشد، ورود موقتاً قفل است
  updatedAt      DateTime  @updatedAt
}

// ─────────────────────────────────────────────
//  رویدادها (Events) - تقویم + رویدادهای ویژه (تولد، سالگرد و ...)
// ─────────────────────────────────────────────
model Event {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  time      String?
  color     String   @default("#8B5CF6")
  note      String?
  // نوع رویداد ویژه: BIRTHDAY | ANNIVERSARY | APPOINTMENT | MEMORIAL | CUSTOM
  type      String   @default("CUSTOM")
  // تکرار سالانه بر اساس همان روزِ شمسی (مثل تولدها و سالگردها)
  yearly    Boolean  @default(false)
  // سال تولد شمسی (برای محاسبه سن، اختیاری)
  birthYear Int?
  createdAt DateTime @default(now())
}
